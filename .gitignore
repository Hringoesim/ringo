node_modules
dist
dist-ssr
*.local
*.tsbuildinfo

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local agent skills (installed via npx skills)
.agents/

# Capacitor native projects (ios/ and android/) are committed so the repo is a
# ready-to-build app project. Build artifacts inside them are excluded by each
# platform's own .gitignore (ios/.gitignore, android/.gitignore).

# Env
.env
.env.local
.vercel

# Headless Chrome profiles written by appstore/scripts/cdp-shoot.mjs: never commit (browser caches, Chrome keys)
appstore/scripts/chrome-cdp-profile/
appstore/scripts/chrome-*profile*/
appstore/scripts/*.log

# Env files of every flavour (keys, tokens). Only the example is committed.
.env.*
!.env.example

# Browser automation profiles and their output, wherever a script puts them
# (a ~1,400-file Chrome profile was committed by accident once: 12d3e4d).
*chrome*profile*/
*chromium*profile*/
*cdp-profile*/
.puppeteer/
.playwright/
playwright-report/
test-results/
**/user-data-dir/
**/User Data/

# Build and tool output
/build/
coverage/
.vite/
.eslintcache
*.log
*.tgz

# Signing material: never in the repo
*.p8
*.p12
*.mobileprovision
*.keystore
*.jks
